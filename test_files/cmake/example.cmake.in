# A configure_file template. Upstream cmakelint refuses to lint a .cmake.in
# file; ament widens IsValidFile so it is linted, and so does ros-lint-cmake.

set(CPP_PKG_VERSION "@cpp_pkg_VERSION@")
set(CPP_PKG_LIBRARIES "@CPP_PKG_LIBRARIES@")

if(NOT TARGET cpp_pkg::cpp_pkg)
  message(STATUS "cpp_pkg ${CPP_PKG_VERSION} was configured without its targets")
endif()
