<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format2.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>format2_pkg</name>
  <version>0.1.0</version>
  <description>
    A package manifest in the older format 2, kept as a fixture so the bundled
    package_format2.xsd is exercised alongside the format 3 schema.
  </description>
  <maintainer email="test@example.com">Test Example</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <exec_depend>rclcpp</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
